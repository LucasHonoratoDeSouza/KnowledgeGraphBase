{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge OS",
  "version": "0.1.0",
  "identifier": "dev.knowledge-os.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knowledge OS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RUY5MTE0NzNBMURCMjUKUldRbDI2RnpGSkh2eHc3NHNPMXB0dGxIZnlIZnZzTFJOSDF5L1NVMDAxcFJjSFRlaC9zYjJZUmQK",
      "endpoints": [
        "https://github.com/LucasHonoratoDeSouza/KnowledgeGraphBase/releases/download/dev/latest.json"
      ]
    }
  }
}
